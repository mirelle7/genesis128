<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>Genesis128</AssemblyName>
    <RootNamespace>Genesis</RootNamespace>
    <Version>2.0.0</Version>
    <NoWarn>CS0618;CS8632;CA1416;SYSLIB0011;CS0168;CS0219</NoWarn>
    <ServerGarbageCollection>false</ServerGarbageCollection>
  </PropertyGroup>
  <ItemGroup>
    <None Include="Templates\**;Scripts\**;INI\**;Sceneries\**;MapLayouts.xml" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
